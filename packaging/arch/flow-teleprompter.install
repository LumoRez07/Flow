#
# pacman's built-in gtk-update-icon-cache hook only fires when a whole new
# top-level icon theme directory appears; it does not cover files an
# application package adds into the already-installed shared "hicolor"
# theme. Without this, the icon cache stays stale and app launchers/menus
# fall back to a generic icon until something else happens to rebuild it.

post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor &>/dev/null || true
  update-desktop-database -q &>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  post_install
}
