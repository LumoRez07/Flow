[Desktop Entry]
Type=Application
Name=Flow
GenericName=Teleprompter
Comment=A modern desktop teleprompter for smooth reading, quick editing, voice controls, and remote message injection
Exec=flow %U
Icon=flow-teleprompter
Terminal=false
Categories=AudioVideo;Utility;
StartupWMClass=flow
StartupNotify=true
