{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flow",
  "version": "2.0.0",
  "identifier": "lumorez",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Flow",
        "width": 550,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "Flow Splash",
        "width": 550,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: https: data:; connect-src 'self' https://api.groq.com https://flowremote.app wss://flowremote.app https://cdn.jsdelivr.net https://github.com https://fonts.googleapis.com https://fonts.gstatic.com wss://0.peerjs.com https://0.peerjs.com wss://*.peerjs.com https://*.peerjs.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob: https://cdn.jsdelivr.net",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwODBEMDc2Mzk5NzkyQQpSV1FxZVpsakJ3MElBd2pFS0s2Zm0rd2prdnM5NW1XakJCcVJkcGpkeHdEdUNZbnhDbUpsd0pOTAo=",
      "endpoints": [
        "https://github.com/LumoRez07/Flow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
